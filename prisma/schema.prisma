generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BOUNCER
  VENUE_MANAGER
  DUTY_MANAGER
}

model Staff {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role

  alerts        Alert[]
  bans          Ban[]
  venueManages VenueManager[]
  dutyManages  DutyManager[]
}

model Alert {
  id             String        @id @default(uuid())
  reason         String
  imagePath      String
  startDate      DateTime      @default(now())
  createdById    String
  createdBy      Staff         @relation(fields: [createdById], references: [id])
  bannedPersonId String?       @unique
  bannedPerson   BannedPerson? @relation(fields: [bannedPersonId], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model VenueManager {
  id      String @id @default(uuid())
  staffId String
  venueId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([staffId, venueId])
  @@index([venueId])
}

model DutyManager {
  id      String @id @default(uuid())
  staffId String
  venueId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([staffId, venueId])
  @@index([venueId])
}

model Venue {
  id           String         @id @default(uuid())
  name         String
  imagePath    String
  managers     VenueManager[]
  dutyManagers DutyManager[]
  venueBans    VenueBan[]
}

model BannedPerson {
  id        String @id @default(uuid())
  name      String
  imagePath String
  alert     Alert?
  bans      Ban[]
}

model Ban {
  id             String       @id @default(uuid())
  reason         String
  startDate      DateTime
  endDate        DateTime
  isPending      Boolean
  bannedPersonId String
  bannedPerson   BannedPerson @relation(fields: [bannedPersonId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      Staff        @relation(fields: [createdById], references: [id])
  venueBans      VenueBan[]

  @@index([bannedPersonId])
  @@index([createdById])
}

model VenueBan {
  id      String @id @default(uuid())
  venueId String
  banId   String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  ban     Ban    @relation(fields: [banId], references: [id], onDelete: Cascade)

  @@unique([venueId, banId])
  @@index([banId])
}
